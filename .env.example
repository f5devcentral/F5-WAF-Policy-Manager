# F5 WAF Policy Manager - Environment Variables

# NGINX Repository Certificate and Key paths
# Used by Docker BuildKit secrets to install security updates (attack signatures, bot signatures, threat campaigns)
NGINX_CERT=/etc/ssl/nginx/nginx-repo.crt
NGINX_KEY=/etc/ssl/nginx/nginx-repo.key

# F5 WAF Compiler Base Image
# Requires client certs configured in /etc/docker/certs.d/private-registry.nginx.com/
WAF_COMPILER_IMAGE=private-registry.nginx.com/nap/waf-compiler:latest

# Application configuration
APP_PORT=8000
APP_DEBUG=false

# Compiler Service configuration
COMPILER_PORT=9000

# Storage Backend selection: 'redis' | 'github' | 'memory'
STORAGE_BACKEND=redis

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXPOSE_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=

# GitHub GitOps Backend configuration (used when STORAGE_BACKEND=github or configured in UI)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_API_URL=https://api.github.com
GITHUB_POLICIES_PATH=policies
GITHUB_LOG_PROFILES_PATH=log-profiles
GITHUB_CUSTOM_SIGS_PATH=custom-signatures

# Violation Logs & Tuning Source: 'clickhouse' | 'nginx_one'
VIOLATIONS_SOURCE=clickhouse

# ClickHouse Configuration (NGINX Instance Manager Security Monitoring)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=nms
CLICKHOUSE_SSL=false
CLICKHOUSE_VERIFY_SSL=false

# NGINX One Console Configuration (SaaS WAF Security Events & Policy Tuning)
# Connects to: https://{NGINX_ONE_TENANT_CNAME}.console.ves.volterra.io/api/nginx/one/namespaces/{NGINX_ONE_NAMESPACE}/app-protect/events
NGINX_ONE_TENANT_CNAME=
NGINX_ONE_BASE_URL=
NGINX_ONE_NAMESPACE=default
NGINX_ONE_API_TOKEN=
NGINX_ONE_VERIFY_SSL=true


